    {
      "cell_type": "code",
      "source": [
        "# ══════════════════════════════════════════════════════════════════\n",
        "# Cell 16 — Bootstrap confidence intervals on the headline finding\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "# Runs 1,000 bootstrap resamples on the test set at canonical settings\n",
        "# (threshold=0.5, LGD=0.4, discount=0.03) and exports:\n",
        "#   - 95% percentile CIs for DI, gap, SPD, EOD per model\n",
        "#   - Paradox significance test (one-sided)\n",
        "# Output: artifacts/bootstrap_cis.json\n",
        "# Runtime: ~5-10 min for 1,000 iterations on 95K samples.\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "\n",
        "import json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from tqdm.notebook import tqdm\n",
        "\n",
        "# ── Load artifacts ─────────────────────────────────────────────────\n",
        "test_probs = pd.read_parquet('artifacts/test_probs.parquet')\n",
        "test_meta  = pd.read_parquet('artifacts/test_meta.parquet')\n",
        "cost_meta_df = pd.read_parquet('artifacts/cost_meta.parquet')\n",
        "\n",
        "y_true_arr = test_meta['y_true'].values.astype(int)\n",
        "race_arr   = test_meta['race_binary'].values.astype(int)\n",
        "loans_arr  = cost_meta_df['loan_amount'].values.astype(float)\n",
        "rates_arr  = cost_meta_df['interest_rate'].values.astype(float)\n",
        "terms_arr  = cost_meta_df['loan_term_years'].values.astype(float)\n",
        "\n",
        "n_samples = len(test_meta)\n",
        "print(f\"Loaded {n_samples:,} test records, {len(test_probs.columns)} models\")\n",
        "\n",
        "\n",
        "# ── Vectorized cost functions (mirror app.py) ──────────────────────\n",
        "def amortized_interest_npv_vec(loans, rates, terms, discount_rate):\n",
        "    r = rates / 100.0 / 12.0\n",
        "    d = discount_rate / 12.0\n",
        "    n = (terms * 12).astype(int)\n",
        "    valid = (r > 0) & (n > 0)\n",
        "    npv = np.zeros_like(loans, dtype=float)\n",
        "\n",
        "    one_plus_r_n = np.zeros_like(loans, dtype=float)\n",
        "    one_plus_r_n[valid] = (1 + r[valid]) ** n[valid]\n",
        "    mp = np.zeros_like(loans, dtype=float)\n",
        "    mp[valid] = (\n",
        "        loans[valid] * (r[valid] * one_plus_r_n[valid])\n",
        "        / (one_plus_r_n[valid] - 1)\n",
        "    )\n",
        "    npv[valid] = (\n",
        "        mp[valid] * (1 - (1 + d) ** (-n[valid])) / d\n",
        "        - loans[valid]\n",
        "    )\n",
        "    return npv\n",
        "\n",
        "\n",
        "def remaining_balance_vec(loans, rates, terms, default_years):\n",
        "    r = rates / 100.0 / 12.0\n",
        "    n = (terms * 12).astype(int)\n",
        "    k = (default_years * 12).astype(int)\n",
        "    valid = (r > 0) & (n > 0)\n",
        "    rb = loans.copy().astype(float)\n",
        "\n",
        "    one_plus_r_n = np.zeros_like(loans, dtype=float)\n",
        "    one_plus_r_n[valid] = (1 + r[valid]) ** n[valid]\n",
        "    mp = np.zeros_like(loans, dtype=float)\n",
        "    mp[valid] = (\n",
        "        loans[valid] * (r[valid] * one_plus_r_n[valid])\n",
        "        / (one_plus_r_n[valid] - 1)\n",
        "    )\n",
        "\n",
        "    one_plus_r_k = np.zeros_like(loans, dtype=float)\n",
        "    one_plus_r_k[valid] = (1 + r[valid]) ** k[valid]\n",
        "    rb[valid] = np.maximum(\n",
        "        loans[valid] * one_plus_r_k[valid]\n",
        "        - mp[valid] * (one_plus_r_k[valid] - 1) / r[valid],\n",
        "        0.0,\n",
        "    )\n",
        "    return rb\n",
        "\n",
        "\n",
        "def compute_metrics_indexed(idx, probs_array, threshold, lgd, discount_rate):\n",
        "    \"\"\"Compute fairness/cost metrics on a (possibly bootstrap) index set.\"\"\"\n",
        "    preds = (probs_array[idx] >= threshold).astype(int)\n",
        "    yt    = y_true_arr[idx]\n",
        "    race  = race_arr[idx]\n",
        "    l     = loans_arr[idx]\n",
        "    r_    = rates_arr[idx]\n",
        "    t_    = terms_arr[idx]\n",
        "\n",
        "    results = {}\n",
        "    for group, label in [(1, 'White'), (0, 'NonWhite')]:\n",
        "        mask = race == group\n",
        "        if not mask.any():\n",
        "            return None\n",
        "\n",
        "        ytg, ypg = yt[mask], preds[mask]\n",
        "        lg, rg, tg = l[mask], r_[mask], t_[mask]\n",
        "        n_g = int(mask.sum())\n",
        "\n",
        "        tp = int(((ytg == 1) & (ypg == 1)).sum())\n",
        "        fn = int(((ytg == 1) & (ypg == 0)).sum())\n",
        "        fn_mask = (ytg == 1) & (ypg == 0)\n",
        "        fp_mask = (ytg == 0) & (ypg == 1)\n",
        "\n",
        "        fn_cost = 0.0\n",
        "        if fn_mask.any():\n",
        "            fn_cost = float(amortized_interest_npv_vec(\n",
        "                lg[fn_mask], rg[fn_mask], tg[fn_mask], discount_rate\n",
        "            ).sum())\n",
        "\n",
        "        fp_cost = 0.0\n",
        "        if fp_mask.any():\n",
        "            fp_cost = float((remaining_balance_vec(\n",
        "                lg[fp_mask], rg[fp_mask], tg[fp_mask], tg[fp_mask] / 2.0\n",
        "            ) * lgd).sum())\n",
        "\n",
        "        tpr = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
        "        results[label] = {\n",
        "            'approval_rate': float(ypg.mean()),\n",
        "            'tpr':           tpr,\n",
        "            'per_applicant': (fn_cost + fp_cost) / n_g if n_g > 0 else 0.0,\n",
        "        }\n",
        "\n",
        "    di_denom = max(results['White']['approval_rate'], 1e-9)\n",
        "    return {\n",
        "        'di':  results['NonWhite']['approval_rate'] / di_denom,\n",
        "        'spd': results['NonWhite']['approval_rate'] - results['White']['approval_rate'],\n",
        "        'eod': results['NonWhite']['tpr']           - results['White']['tpr'],\n",
        "        'gap': results['NonWhite']['per_applicant'] - results['White']['per_applicant'],\n",
        "    }\n",
        "\n",
        "\n",
        "# ── Run bootstrap ──────────────────────────────────────────────────\n",
        "N_ITER     = 1000\n",
        "THRESHOLD  = 0.5\n",
        "LGD        = 0.4\n",
        "DISCOUNT   = 0.03\n",
        "\n",
        "np.random.seed(42)\n",
        "print(f\"Running {N_ITER} bootstrap iterations × {len(test_probs.columns)} models...\")\n",
        "\n",
        "results_by_model = {\n",
        "    m: {'di': [], 'gap': [], 'spd': [], 'eod': []}\n",
        "    for m in test_probs.columns\n",
        "}\n",
        "\n",
        "probs_arrays = {m: test_probs[m].values for m in test_probs.columns}\n",
        "\n",
        "for _ in tqdm(range(N_ITER)):\n",
        "    idx = np.random.choice(n_samples, n_samples, replace=True)\n",
        "    for m in test_probs.columns:\n",
        "        out = compute_metrics_indexed(idx, probs_arrays[m], THRESHOLD, LGD, DISCOUNT)\n",
        "        if out is not None:\n",
        "            for k in ['di', 'gap', 'spd', 'eod']:\n",
        "                results_by_model[m][k].append(out[k])\n",
        "\n",
        "\n",
        "# ── Aggregate CIs and point estimates ──────────────────────────────\n",
        "ci_data = {\n",
        "    'metadata': {\n",
        "        'n_iterations': N_ITER,\n",
        "        'n_samples':    n_samples,\n",
        "        'threshold':    THRESHOLD,\n",
        "        'lgd':          LGD,\n",
        "        'discount':     DISCOUNT,\n",
        "        'method':       'percentile bootstrap, 95% CI (2.5–97.5)',\n",
        "        'seed':         42,\n",
        "    },\n",
        "    'models': {},\n",
        "}\n",
        "\n",
        "# Point estimate at default settings (no resampling)\n",
        "full_idx = np.arange(n_samples)\n",
        "point_estimates = {\n",
        "    m: compute_metrics_indexed(full_idx, probs_arrays[m], THRESHOLD, LGD, DISCOUNT)\n",
        "    for m in test_probs.columns\n",
        "}\n",
        "\n",
        "for m in test_probs.columns:\n",
        "    ci_data['models'][m] = {}\n",
        "    for metric in ['di', 'gap', 'spd', 'eod']:\n",
        "        vals = np.array(results_by_model[m][metric])\n",
        "        ci_data['models'][m][metric] = {\n",
        "            'point_estimate': float(point_estimates[m][metric]),\n",
        "            'bootstrap_mean': float(vals.mean()),\n",
        "            'std':            float(vals.std()),\n",
        "            'ci_lower':       float(np.percentile(vals, 2.5)),\n",
        "            'ci_upper':       float(np.percentile(vals, 97.5)),\n",
        "        }\n",
        "\n",
        "\n",
        "# ── Paradox significance test ──────────────────────────────────────\n",
        "point_dis  = {m: point_estimates[m]['di']  for m in test_probs.columns}\n",
        "point_gaps = {m: point_estimates[m]['gap'] for m in test_probs.columns}\n",
        "\n",
        "highest_di_model    = max(point_dis,  key=point_dis.get)\n",
        "smallest_gap_model  = min(point_gaps, key=lambda m: abs(point_gaps[m]))\n",
        "\n",
        "if highest_di_model != smallest_gap_model:\n",
        "    n_holds = sum(\n",
        "        1 for i in range(N_ITER)\n",
        "        if abs(results_by_model[highest_di_model]['gap'][i])\n",
        "         > abs(results_by_model[smallest_gap_model]['gap'][i])\n",
        "    )\n",
        "    p_val = (N_ITER - n_holds + 1) / (N_ITER + 1)  # +1 smoothing\n",
        "\n",
        "    ci_data['paradox_test'] = {\n",
        "        'highest_di_model':    highest_di_model,\n",
        "        'smallest_gap_model':  smallest_gap_model,\n",
        "        'n_iterations_paradox_holds': n_holds,\n",
        "        'p_value_one_sided':   p_val,\n",
        "        'description':         f'Paradox holds in {n_holds}/{N_ITER} bootstrap samples',\n",
        "    }\n",
        "else:\n",
        "    ci_data['paradox_test'] = {\n",
        "        'note': 'Highest-DI and smallest-gap models coincide at the point estimate',\n",
        "    }\n",
        "\n",
        "\n",
        "# ── Save ───────────────────────────────────────────────────────────\n",
        "with open('artifacts/bootstrap_cis.json', 'w') as f:\n",
        "    json.dump(ci_data, f, indent=2)\n",
        "\n",
        "print(f\"\\n✅ Saved artifacts/bootstrap_cis.json\")\n",
        "print(f\"\\n{'='*60}\")\n",
        "print(f\"HEADLINE SUMMARY (at threshold={THRESHOLD}, LGD={LGD}, discount={DISCOUNT})\")\n",
        "print(f\"{'='*60}\")\n",
        "for m in test_probs.columns:\n",
        "    di  = ci_data['models'][m]['di']\n",
        "    gap = ci_data['models'][m]['gap']\n",
        "    print(f\"\\n{m}:\")\n",
        "    print(f\"  DI:  {di['point_estimate']:.4f} \"\n",
        "          f\"[{di['ci_lower']:.4f}, {di['ci_upper']:.4f}]\")\n",
        "    print(f\"  Gap: ${gap['point_estimate']:+,.0f} \"\n",
        "          f\"[${gap['ci_lower']:+,.0f}, ${gap['ci_upper']:+,.0f}]\")\n",
        "\n",
        "if 'p_value_one_sided' in ci_data['paradox_test']:\n",
        "    pt = ci_data['paradox_test']\n",
        "    print(f\"\\n{'='*60}\")\n",
        "    print(f\"PARADOX SIGNIFICANCE TEST\")\n",
        "    print(f\"{'='*60}\")\n",
        "    print(f\"H1: |gap({pt['highest_di_model']})| > |gap({pt['smallest_gap_model']})|\")\n",
        "    print(f\"Paradox holds in {pt['n_iterations_paradox_holds']}/{N_ITER} bootstrap samples\")\n",
        "    print(f\"One-sided p-value: {pt['p_value_one_sided']:.4f}\")"
      ],
