        "# ══════════════════════════════════════════════════════════════════\n",
        "# CELL 15 — Export artifacts for Streamlit app\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "# Run this AFTER all models are trained (i.e. after Cell 9).\n",
        "# It saves three parquet files + a zip:\n",
        "#   - test_probs.parquet : predict_proba for each exported model\n",
        "#   - test_meta.parquet  : y_true + race_binary for the test set\n",
        "#   - cost_meta.parquet  : loan_amount, interest_rate, loan_term_years,\n",
        "#                          property_value for the test set\n",
        "#\n",
        "# Total size ~5-10 MB. Fits in a GitHub repo for Streamlit Cloud.\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "import os\n",
        "import zipfile\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "os.makedirs('artifacts', exist_ok=True)\n",
        "\n",
        "# Keep the demo tight — 3 models is sharper than 10.\n",
        "# LR Baseline   = no debiasing reference\n",
        "# LR Manual RW  = linear + fairness reweighing\n",
        "# NN Focal Loss = the winner from your sensitivity analysis\n",
        "sklearn_models_to_export = {\n",
        "    'LR Baseline':  (lr,    X_test_scaled),\n",
        "    'LR Manual RW': (lr_rw, X_test_scaled),\n",
        "}\n",
        "\n",
        "probs_data = {}\n",
        "for name, (model, X_sc) in sklearn_models_to_export.items():\n",
        "    probs_data[name] = model.predict_proba(X_sc)[:, 1]\n",
        "\n",
        "# NN doesn't have predict_proba in sklearn sense — we already have nn_focal_probs\n",
        "probs_data['NN + Focal Loss'] = nn_focal_probs\n",
        "\n",
        "probs_df = pd.DataFrame(probs_data)\n",
        "probs_df.to_parquet('artifacts/test_probs.parquet')\n",
        "print(f\"✅ test_probs.parquet  shape={probs_df.shape}  \"\n",
        "      f\"size={os.path.getsize('artifacts/test_probs.parquet')/1e6:.2f} MB\")\n",
        "\n",
        "# Test labels + protected attribute\n",
        "test_meta = pd.DataFrame({\n",
        "    'y_true':      y_test_np,\n",
        "    'race_binary': race_test_np,\n",
        "})\n",
        "test_meta.to_parquet('artifacts/test_meta.parquet')\n",
        "print(f\"✅ test_meta.parquet   shape={test_meta.shape}  \"\n",
        "      f\"size={os.path.getsize('artifacts/test_meta.parquet')/1e6:.2f} MB\")\n",
        "\n",
        "# Cost columns we'll need\n",
        "cost_export = cost_test[\n",
        "    ['loan_amount', 'interest_rate', 'loan_term_years', 'property_value']\n",
        "].reset_index(drop=True)\n",
        "cost_export.to_parquet('artifacts/cost_meta.parquet')\n",
        "print(f\"✅ cost_meta.parquet   shape={cost_export.shape}  \"\n",
        "      f\"size={os.path.getsize('artifacts/cost_meta.parquet')/1e6:.2f} MB\")\n",
        "\n",
        "# Zip everything for easy download\n",
        "with zipfile.ZipFile('artifacts.zip', 'w', zipfile.ZIP_DEFLATED) as zf:\n",
        "    for f in os.listdir('artifacts'):\n",
        "        zf.write(f'artifacts/{f}', arcname=f)\n",
        "\n",
        "print(f\"\\n📦 artifacts.zip       \"\n",
        "      f\"size={os.path.getsize('artifacts.zip')/1e6:.2f} MB\")\n",
        "\n",
        "# Sanity check\n",
        "print(\"\\n=== SANITY CHECK ===\")\n",
        "print(f\"  Probabilities range: \"\n",
