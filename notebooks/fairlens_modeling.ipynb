   "outputs": [],
   "source": "# CELL 12 â NPV/LGD Sensitivity Analysis (FIXED: real dynamic LGD)\n# ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\n# CHANGE LOG vs prior version:\n#   - Prior code looked for an LTV column in cost_test, found\n#     `property_value` (a dollar amount) and clipped it to [0,1] â\n#     which mapped every row to ~1.0 and made dynamic LGD a flat 0.9.\n#   - This version computes actual LTV = loan_amount / property_value\n#     and uses an LTV-driven LGD model with the standard intuition:\n#     less equity cushion â higher loss given default.\n#\n# LGD model: LGD = 0.5 Ã LTV, clipped to [0.10, 0.90]\n#   At LTV = 1.0 (no equity)        â LGD = 0.50\n#   At LTV = 0.8 (20% equity)       â LGD = 0.40   (â industry default)\n#   At LTV = 0.5 (50% equity)       â LGD = 0.25\n# This is a documented assumption, not ground truth â surface in writeup.\n# ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"NPV/LGD SENSITIVITY ANALYSIS (Point 3)\")\nprint(\"Does model ranking change under different economic assumptions?\")\nprint(\"=\" * 80)\n\nscenarios = [\n    {\"label\": \"Base (3%, LGD=0.40)\",  \"discount\": 0.03, \"lgd\": 0.40},\n    {\"label\": \"High rate (5%)\",        \"discount\": 0.05, \"lgd\": 0.40},\n    {\"label\": \"High LGD (0.55)\",       \"discount\": 0.03, \"lgd\": 0.55},\n]\n\n# ââ Dynamic LGD from actual LTV ââââââââââââââââââââââââââââââââââââ\nif 'property_value' in cost_test.columns and 'loan_amount' in cost_test.columns:\n    pv = cost_test['property_value'].values.astype(float)\n    la = cost_test['loan_amount'].values.astype(float)\n\n    # Compute LTV with safe handling of zero/missing property values\n    ltv_raw = np.where(pv > 0, la / pv, np.nan)\n    median_ltv = np.nanmedian(ltv_raw)\n    ltv = np.where(np.isnan(ltv_raw), median_ltv, ltv_raw)\n\n    # Cap LTV at 1.5 â over-leveraged loans exist but values above 1.5\n    # are almost always data errors (e.g. property_value reported in\n    # thousands instead of dollars).\n    ltv = np.clip(ltv, 0.0, 1.5)\n\n    # LGD model â see header for derivation\n    dynamic_lgd = np.clip(0.5 * ltv, 0.10, 0.90)\n\n    scenarios.append({\"label\": \"Dynamic LGD (LTV-based)\",\n                  \"discount\": 0.03, \"lgd\": dynamic_lgd})   # was 0.05\n\n    print(f\"\\nLTV computed from loan_amount / property_value\")\n    print(f\"  LTV stats         â mean: {ltv.mean():.3f}  \"\n          f\"median: {np.median(ltv):.3f}  \"\n          f\"min: {ltv.min():.3f}  max: {ltv.max():.3f}\")\n    print(f\"  Dynamic LGD stats â mean: {dynamic_lgd.mean():.3f}  \"\n          f\"median: {np.median(dynamic_lgd):.3f}  \"\n          f\"min: {dynamic_lgd.min():.3f}  max: {dynamic_lgd.max():.3f}\")\n    print(f\"  â 4 scenarios total\\n\")\nelse:\n    print(\"\\n  property_value or loan_amount missing â 3 fixed scenarios only\\n\")\n\n# ââ Run sensitivity âââââââââââââââââââââââââââââââââââââââââââââââ\nsensitivity_results = {}\nfor sc in scenarios:\n    sc_gaps = {}\n    for name, preds, _, _, _ in all_models:\n        _, gap = compute_dollar_cost(\n            y_test_np, preds, race_test_np,\n            loan_amounts, interest_rates, loan_terms,\n            lgd=sc['lgd'], discount_rate=sc['discount'],\n            model_name=name, verbose=False\n        )\n        sc_gaps[name] = float(gap)\n    sensitivity_results[sc['label']] = sc_gaps\n\n# ââ Display: gap table ââââââââââââââââââââââââââââââââââââââââââââ\ncol_w       = 22\nmodel_names = [m[0] for m in all_models]\n\nprint(f\"\\n{'Model':<25}\", end=\"\")\nfor sc in scenarios:\n    print(f\"{sc['label']:>{col_w}}\", end=\"\")\nprint(f\"{'Stable?':>10}\")\nprint(\"â\" * (25 + col_w * len(scenarios) + 10))\n\nfor name in model_names:\n    print(f\"{name:<25}\", end=\"\")\n    gaps  = [sensitivity_results[sc['label']][name] for sc in scenarios]\n    signs = set(1 if g >= 0 else -1 for g in gaps)\n    for g in gaps:\n        print(f\"${g:>{col_w-1},.0f}\", end=\"\")\n    print(f\"{'â' if len(signs) == 1 else 'â ï¸':>10}\")\n\nprint(\"â\" * (25 + col_w * len(scenarios) + 10))\n\n# ââ Display: rank table âââââââââââââââââââââââââââââââââââââââââââ\nprint(\"\\nRANK TABLE (1 = smallest gap):\")\nranks = {}\nfor sc in scenarios:\n    srt = sorted(sensitivity_results[sc['label']].keys(),\n                 key=lambda k: abs(sensitivity_results[sc['label']][k]))\n    ranks[sc['label']] = {n: i + 1 for i, n in enumerate(srt)}\n\nprint(f\"\\n{'Model':<25}\", end=\"\")\nfor sc in scenarios:\n    print(f\"{sc['label']:>{col_w}}\", end=\"\")\nprint()\nprint(\"â\" * (25 + col_w * len(scenarios)))\nfor name in model_names:\n    print(f\"{name:<25}\", end=\"\")\n    for sc in scenarios:\n        print(f\"{'#' + str(ranks[sc['label']][name]):>{col_w}}\", end=\"\")\n    print()\n\nprint(\"\\nIf rankings are stable across scenarios â Fairness Paradox is ROBUST.\")\n\n# ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ"
  },
